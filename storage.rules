rules_version = '2';

// Firebase Storage Security Rules for Allobailleur
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // TEMPORARY: Allow all authenticated users to upload to properties folder
    // TODO: Implement proper ownership verification
    match /properties/{propertyId}/{allPaths=**} {
      // Allow authenticated users to upload images (temporary for testing)
      allow create: if isAuthenticated() &&
                       request.resource.size < 10 * 1024 * 1024 && // 10MB max
                       request.resource.contentType.matches('image/.*');

      // Users can read images from any property (for display)
      allow read: if true;

      // Allow authenticated users to update/delete (temporary for testing)
      allow update, delete: if isAuthenticated();
    }

    // Allow users to upload profile images
    match /users/{userId}/profile/{allPaths=**} {
      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       request.resource.size < 5 * 1024 * 1024 && // 5MB max
                       request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}