rules_version = '2';

// Firebase Storage Security Rules for Allobailleur
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOfProperty(propertyId) {
      return firestore.exists(/databases/(default)/documents/properties/$(propertyId)) &&
             firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    // Allow users to upload images to their property folders
    match /properties/{propertyId}/{allPaths=**} {
      // Users can upload images to properties they own
      allow create: if isAuthenticated() &&
                       isOwnerOfProperty(propertyId) &&
                       request.resource.size < 10 * 1024 * 1024 && // 10MB max
                       request.resource.contentType.matches('image/.*');

      // Users can read images from any property (for display)
      allow read: if true;

      // Users can update/delete images from properties they own
      allow update, delete: if isAuthenticated() && isOwnerOfProperty(propertyId);
    }

    // Allow users to upload profile images
    match /users/{userId}/profile/{allPaths=**} {
      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       request.resource.size < 5 * 1024 * 1024 && // 5MB max
                       request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}