rules_version = '2';

// TEMPORARY Firebase Storage Security Rules for Testing
// TODO: Implement proper security rules after testing
service firebase.storage {
  match /b/{bucket}/o {
    // Allow all operations for testing (REMOVE AFTER TESTING)
    match /properties/{allPaths=**} {
      allow read, write: if true;
    }

    match /users/{allPaths=**} {
      allow read, write: if true;
    }

    // Default allow for testing
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}